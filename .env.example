# Copy to `.env` for local development.

# Postgres from docker-compose.yml
DATABASE_URL="postgresql://quartermaster:quartermaster@127.0.0.1:54329/quartermaster"
# Integration tests (npm run test:integration) create a throw-away database per run next to this one.
DATABASE_URL_TEST="postgresql://quartermaster:quartermaster@127.0.0.1:54329/quartermaster_test"

# 32-byte key (base64) used to encrypt secrets at rest, e.g. TOTP secrets.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""

# Host that serves the admin for all tenants (superadmin) — tenants are resolved by host otherwise.
PLATFORM_HOST="localhost:3000"

# Local seed accounts (development only)
SEED_SUPERADMIN_EMAIL="admin@quartermaster.test"
SEED_SUPERADMIN_PASSWORD="change-me-locally"
SEED_OWNER_EMAIL="owner@concept-militaria.test"
SEED_OWNER_PASSWORD="change-me-locally"

# Local image storage (default: ./uploads). STORAGE_DRIVER=local is the only driver for now.
# UPLOADS_DIR="./uploads"
# STORAGE_DRIVER="local"

# Matomo (optional analytics provider). The token is only ever sent to MATOMO_URL, never to a
# URL a shop owner types into settings.
# MATOMO_URL="https://stats.example.com"
# MATOMO_TOKEN=""

# ─── Mail & background jobs ─────────────────────────────────────────────────
# SMTP connection for outgoing mail (nodemailer URL), e.g. "smtps://user:pass@smtp.example.com:465".
# Leave empty in development: mails are written as .eml files to .local/mail/ (or MAIL_OUTBOX_DIR).
SMTP_URL=""
# Sending address for all shops (must be allowed by SPF/DKIM of your SMTP provider). The display name
# comes from each shop's mail settings; Reply-To from the shop's reply-to/contact email.
MAIL_FROM_FALLBACK="no-reply@quartermaster.localhost"
# Bearer token for POST /api/cron/<task> (Kubernetes CronJob / system cron). Empty = endpoint disabled.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""
# Public base URL of the platform; used for links in mails when a shop has no domain, and for the
# URL scheme (http/https) of shop links. Example: "https://quartermaster.example".
APP_URL="http://localhost:3000"
