# Copy to `.env` for local development.

# Postgres from docker-compose.yml
DATABASE_URL="postgresql://quartermaster:quartermaster@127.0.0.1:54329/quartermaster"
# Integration tests (npm run test:integration) create a throw-away database per run next to this one.
DATABASE_URL_TEST="postgresql://quartermaster:quartermaster@127.0.0.1:54329/quartermaster_test"

# 32-byte key (base64) used to encrypt secrets at rest, e.g. TOTP secrets.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""

# Number of trusted reverse proxies in front of the app that append to X-Forwarded-For
# (src/server/request-meta.ts). 0 (default) = trust no proxy headers: client IPs are unknown, so
# per-IP rate limits fall back to shared buckets — fine for local dev, NOT for production.
# Behind ingress-nginx: 1. Behind a cloud load balancer + ingress-nginx (both appending): 2.
TRUSTED_PROXY_HOPS="0"

# Content-Security-Policy (src/lib/csp.ts): "report-only" (default) | "enforce" | "off".
CSP_MODE="report-only"

# Host that serves the admin for all tenants (superadmin) — tenants are resolved by host otherwise.
PLATFORM_HOST="localhost:3000"
# Optional: own host for the Quartermaster network (docs/network.md), served at "/". Empty = the network
# lives at PLATFORM_HOST/network. When set, PLATFORM_HOST/network redirects there (needs DNS + certificate).
NETWORK_HOST=""
# Base host for the platform sub-domain an approved dealer's shop gets: "<slug>.<SHOP_SUBDOMAIN_BASE>".
# Development: "localhost:3000" → "<slug>.localhost:3000" (browsers resolve *.localhost to 127.0.0.1).
# Production: e.g. "quartermaster.nl" with wildcard DNS + certificate for *.quartermaster.nl (docs/deploy.md §15).
SHOP_SUBDOMAIN_BASE="localhost:3000"

# Local seed accounts (development only)
SEED_SUPERADMIN_EMAIL="admin@quartermaster.test"
SEED_SUPERADMIN_PASSWORD="change-me-locally"
SEED_OWNER_EMAIL="owner@concept-militaria.test"
SEED_OWNER_PASSWORD="change-me-locally"

# Local image storage (default: ./uploads). STORAGE_DRIVER=local is the only driver for now.
# UPLOADS_DIR="./uploads"
# STORAGE_DRIVER="local"

# Matomo (optional analytics provider). The token is only ever sent to MATOMO_URL, never to a
# URL a shop owner types into settings.
# MATOMO_URL="https://stats.example.com"
# MATOMO_TOKEN=""

# ─── Mail & background jobs ─────────────────────────────────────────────────
# SMTP connection for outgoing mail (nodemailer URL), e.g. "smtps://user:pass@smtp.example.com:465".
# Leave empty in development: mails are written as .eml files to .local/mail/ (or MAIL_OUTBOX_DIR).
SMTP_URL=""
# Sending address for all shops (must be allowed by SPF/DKIM of your SMTP provider). The display name
# comes from each shop's mail settings; Reply-To from the shop's reply-to/contact email.
MAIL_FROM_FALLBACK="no-reply@quartermaster.localhost"
# Bearer token for POST /api/cron/<task> (Kubernetes CronJob / system cron). Empty = endpoint disabled.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""
# Public base URL of the platform; used for links in mails when a shop has no domain, and for the
# URL scheme (http/https) of shop links. Example: "https://quartermaster.example".
APP_URL="http://localhost:3000"

# ─── Cloudflare Turnstile (bot protection on public shop forms) ─────────────
# Server secret for siteverify (src/server/turnstile). Empty: allowed in development, DENIED in
# production (logged). Add every shop domain to the widget's hostnames in the Cloudflare dashboard.
TURNSTILE_SECRET_KEY=""
# Public site key for the widget (src/components/shop/turnstile). Empty: the widget renders nothing.
# Cloudflare test keys (always pass): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=""
# Optional build-time fallback (inlined into the client bundle); TURNSTILE_SITE_KEY above is preferred.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ─── Web push (docs/push.md) ────────────────────────────────────────────────
# One VAPID key pair for the platform: `npx web-push generate-vapid-keys`. Empty: push is off (the
# shop hides every push option; e-mail alerts work as before). Never change the pair in production
# without expecting every device to subscribe again.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ops@example.com"

# ─── Smart search (docs/search.md) ──────────────────────────────────────────
# The AI models run in their own service: `npm run embedder` (or `docker compose up -d embedder`).
# Without EMBEDDER_URL the shop search is lexical + facets only (everything else works).
EMBEDDER_URL="http://127.0.0.1:3100"
# Shared secret between web/worker and the embedder (the embedder refuses to start without one).
EMBEDDER_TOKEN="dev-embedder-token"
# Embedder service only: where the model files live (downloaded once, ~650 MB). Default .local/models.
# MODEL_CACHE_DIR=".local/models"
# Optional: lexical-only search in this process.  SEARCH_SEMANTIC=off
