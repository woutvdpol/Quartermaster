// NEW: vervangt products.photos JSON (Cloudflare Images ids blijven geldig)
model ProductImage {
  id           Int      @id @default(autoincrement())
  productId    BigInt   @map("product_id") @db.UnsignedBigInt
  cloudflareId String   @unique @map("cloudflare_id") @db.VarChar(64)
  position     Int      @default(0)
  alt          String?  @db.VarChar(255)
  width        Int?
  height       Int?
  filename     String?  @db.VarChar(255) // origineel, bv. "12345b.jpg"
  createdAt    DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("qm_product_images")
}

// NEW: optioneel — alleen nodig als items in maten/varianten komen (nu: ieder item uniek)
model ProductVariant {
  id        Int      @id @default(autoincrement())
  productId BigInt   @map("product_id") @db.UnsignedBigInt
  sku       String   @unique @db.VarChar(64)
  title     String   @db.VarChar(255) // bv. "Maat 52 / conditie B"
  price     Int? // minor units, null = productprijs
  weight    Int? // gram
  quantity  Int      @default(0)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@map("qm_product_variants")
}

// NEW: gestructureerde specificaties (nu JSON in products.specifications)
model ProductSpec {
  id        Int    @id @default(autoincrement())
  productId BigInt @map("product_id") @db.UnsignedBigInt
  key       String @db.VarChar(100)
  value     String @db.VarChar(500)
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("qm_product_specs")
}

// NEW: voorraad-ledger; products.quantity wordt een (gecachte) som hiervan
model StockMovement {
  id        Int                 @id @default(autoincrement())
  productId BigInt              @map("product_id") @db.UnsignedBigInt
  variantId Int?                @map("variant_id")
  delta     Int // +n / -n
  reason    StockMovementReason
  orderId   BigInt?             @map("order_id") @db.UnsignedBigInt
  actorId   BigInt?             @map("actor_id") @db.UnsignedBigInt
  note      String?             @db.VarChar(500)
  createdAt DateTime            @default(now()) @map("created_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([orderId])
  @@map("qm_stock_movements")
}

// NEW: order status machine + historie
model OrderStatusHistory {
  id         Int         @id @default(autoincrement())
  orderId    BigInt      @map("order_id") @db.UnsignedBigInt
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus @map("to_status")
  actorId    BigInt?     @map("actor_id") @db.UnsignedBigInt // null = systeem/webhook
  note       String?     @db.VarChar(500)
  createdAt  DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("qm_order_status_history")
}

// NEW: betalingen los van order (meerdere pogingen, refunds, webhooks)
model Payment {
  id                Int             @id @default(autoincrement())
  orderId           BigInt          @map("order_id") @db.UnsignedBigInt
  provider          PaymentProvider
  providerPaymentId String?         @unique @map("provider_payment_id") @db.VarChar(128) // tr_xxx / PayPal order id
  status            PaymentStatus
  amount            Int // minor units
  currency          String          @db.Char(3)
  surchargeAmount   Int             @default(0) @map("surcharge_amount")
  rawPayload        Json?           @map("raw_payload") // laatste webhook response
  paidAt            DateTime?       @map("paid_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("qm_payments")
}

// NEW: gestructureerde adres-snapshots per order
model OrderAddress {
  id          Int     @id @default(autoincrement())
  orderId     BigInt  @map("order_id") @db.UnsignedBigInt
  type        String  @db.VarChar(16) // 'billing' | 'shipping'
  firstName   String  @map("first_name") @db.VarChar(255)
  lastName    String  @map("last_name") @db.VarChar(255)
  street      String  @db.VarChar(255)
  houseNumber String? @map("house_number") @db.VarChar(32)
  zip         String? @db.VarChar(32)
  city        String  @db.VarChar(255)
  state       String? @db.VarChar(255)
  countryCode String  @map("country_code") @db.Char(2)
  phone       String? @db.VarChar(64)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@map("qm_order_addresses")
}

// NEW: generieke audit log (admin-mutaties op products/orders/settings)
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    BigInt?  @map("actor_id") @db.UnsignedBigInt
  entityType String   @map("entity_type") @db.VarChar(64) // 'Product' | 'Order' | 'Setting' ...
  entityId   String   @map("entity_id") @db.VarChar(64)
  action     String   @db.VarChar(32) // create | update | delete | status_change
  diff       Json? // { field: [old, new] }
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("qm_audit_log")
}

// NEW: historische wisselkoersen (voor rapportage + snapshot op order)
model ExchangeRate {
  id        Int      @id @default(autoincrement())
  base      String   @db.Char(3)
  quote     String   @db.Char(3)
  rate      Decimal  @db.Decimal(18, 8)
  source    String   @db.VarChar(64)
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@index([base, quote, fetchedAt])
  @@map("qm_exchange_rates")
}

// NEW: legacy URL redirects (/product/{id}/{slug} e.d.) voor SEO-behoud
model Redirect {
  id         Int      @id @default(autoincrement())
  fromPath   String   @unique @map("from_path") @db.VarChar(512)
  toPath     String   @map("to_path") @db.VarChar(512)
  statusCode Int      @default(301) @map("status_code")
  hits       Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("qm_redirects")
}
