// Quartermaster — phase 0 foundation (tenants, users, auth, audit, settings)
// + phase 1 domain (catalog, purchasing, customers, cart, orders, shipping,
// content, newsletter, analytics). See docs/schema.md for the design notes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenancy ────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Tenant {
  id               String       @id @default(cuid())
  slug             String       @unique
  name             String
  status           TenantStatus @default(ACTIVE)
  currency         String       @default("EUR") @db.Char(3)
  timezone         String       @default("Europe/Amsterdam")
  // Setup wizard (onboarding): per-step progress { [stepKey]: { done: bool, skipped?: bool, at } };
  // null = shop predates the wizard (treated as set up). setupCompletedAt set on "Go live".
  setupState       Json?
  setupCompletedAt DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  domains     TenantDomain[]
  redirects   Redirect[]
  application DealerApplication?
  importJobs  ImportJob[]
  users       User[]
  settings    Setting[]
  auditLogs   AuditLog[]

  // phase 1 domain
  sequences             TenantSequence[]
  categories            Category[]
  tags                  Tag[]
  products              Product[]
  productImages         ProductImage[]
  productTags           ProductTag[]
  productRelations      ProductRelation[]
  suppliers             Supplier[]
  purchaseRecords       PurchaseRecord[]
  stockMovements        StockMovement[]
  customers             Customer[]
  addresses             Address[]
  wishlistItems         WishlistItem[]
  carts                 Cart[]
  cartItems             CartItem[]
  reservations          Reservation[]
  orders                Order[]
  orderLines            OrderLine[]
  orderAddresses        OrderAddress[]
  orderEvents           OrderEvent[]
  payments              Payment[]
  invoices              Invoice[]
  shippingZones         ShippingZone[]
  shippingRates         ShippingRate[]
  contentPages          ContentPage[]
  contentBlocks         ContentBlock[]
  menuItems             MenuItem[]
  newsletterSubscribers NewsletterSubscriber[]
  newsletterCampaigns   NewsletterCampaign[]
  pageViews             PageView[]
  facets                Facet[]
  facetValues           FacetValue[]
  productFacetValues    ProductFacetValue[]
  savedSearches         SavedSearch[]
  alertDeliveries       AlertDelivery[]
  productDocuments      ProductDocument[]
  certificates          Certificate[]
  complianceRules       ComplianceRule[]
  offers                Offer[]
  coupons               Coupon[]
  couponRedemptions     CouponRedemption[]
  leads                 Lead[]
  productEmbeddings     ProductEmbedding[]
  searchIndexRun        SearchIndexRun?
  fairs                 Fair[]
  fairItems             FairItem[]
  pushSubscriptions     PushSubscription[]
  pushMessages          PushMessage[]

  // Quartermaster network (docs/network.md): stock of opted-in shops appears in the platform-wide
  // search at PLATFORM_HOST/network; buyers check out in the dealer's own shop.
  networkOptIn    Boolean   @default(false)
  networkJoinedAt DateTime?

  @@map("tenants")
}

model TenantDomain {
  id        String   @id @default(cuid())
  tenantId  String
  host      String   @unique // lower-case host incl. port in dev, e.g. "concept.localhost:3000"
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domains")
}

// ─── Users & auth ───────────────────────────────────────────────────────────

enum Role {
  SUPERADMIN // Quartermaster platform admin, no tenant
  OWNER // shop owner, bound to one tenant
  CUSTOMER // shop customer, bound to one tenant
}

model User {
  id              String    @id @default(cuid())
  tenantId        String? // null only for SUPERADMIN
  role            Role
  email           String // stored lower-case
  name            String?
  passwordHash    String? // "scrypt$N$r$p$salt$hash"; null = no password set yet
  emailVerifiedAt DateTime?
  totpSecretEnc   String? // AES-256-GCM encrypted base32 secret
  totpEnabledAt   DateTime?
  disabledAt      DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessions      Session[]
  authTokens    AuthToken[]
  recoveryCodes RecoveryCode[]
  auditLogs     AuditLog[]

  // phase 1 domain
  customer            Customer? // CUSTOMER users have exactly one Customer row in their tenant
  orderEvents         OrderEvent[]
  stockMovements      StockMovement[]
  newsletterCampaigns NewsletterCampaign[]

  // Uniqueness of SUPERADMIN emails (tenantId IS NULL) is enforced by a partial index in SQL.
  @@unique([tenantId, email])
  @@index([email])
  @@map("users")
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique // sha256(token), the raw token only lives in the cookie
  expiresAt   DateTime
  lastSeenAt  DateTime @default(now())
  // A session created with a password but awaiting a TOTP code.
  pendingTotp Boolean  @default(false)
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  INVITE // owner invite after a dealer application is approved (set first password)
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

// Sliding-window rate limiting for login, password reset, etc.
model RateLimitHit {
  id        BigInt   @id @default(autoincrement())
  key       String // e.g. "login:ip:1.2.3.4" or "login:email:t1:jan@x.nl"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("rate_limit_hits")
}

// ─── Audit ──────────────────────────────────────────────────────────────────

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  tenantId  String?
  actorId   String?
  action    String // e.g. "auth.login", "order.mark_paid"
  entity    String?
  entityId  String?
  data      Json?
  ip        String?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ─── Settings ───────────────────────────────────────────────────────────────

// One row per (tenant, group); `data` is validated by a Zod schema per group.
model Setting {
  id        String   @id @default(cuid())
  tenantId  String
  group     String // "general" | "catalog" | "checkout" | "appearance" | …
  data      Json
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, group])
  @@map("settings")
}

// ════════════════════════════════════════════════════════════════════════════
// PHASE 1 — DOMAIN
// Conventions (see docs/schema.md):
// - Every shop-owned row carries `tenantId` (also child rows, so the tenant
//   Prisma extension can filter every model uniformly).
// - Money = Int minor units. Stored amounts on orders/payments carry a
//   `currency Char(3)`; catalog prices are in the tenant currency (Tenant.currency).
// - PKs are cuid strings; human-facing numbers (StockCode, order number,
//   invoice number) are per-tenant Ints allocated from TenantSequence.
// - Nothing commercial is hard-deleted: products → status ARCHIVED,
//   orders → archivedAt. Tenants are archived, not deleted (Restrict).
// ════════════════════════════════════════════════════════════════════════════

// ─── Per-tenant counters ────────────────────────────────────────────────────

// Gapless-ish per-tenant numbering for StockCodes, order and invoice numbers.
// Allocate inside the business transaction:
//   INSERT INTO tenant_sequences ("tenantId", name, value, "updatedAt") VALUES ($1, $2, $start, now())
//   ON CONFLICT ("tenantId", name) DO UPDATE SET value = tenant_sequences.value + 1, "updatedAt" = now()
//   RETURNING value;
// Names: "product.stockCode" (start 50000, legacy), "order.number", "invoice.number".
model TenantSequence {
  tenantId  String
  name      String
  value     Int // last issued value
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, name])
  @@map("tenant_sequences")
}

// ─── Catalog ────────────────────────────────────────────────────────────────

// One stored status per product (decision 11); exact semantics decided later.
enum ProductStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  ARCHIVED
  STOLEN
}

model Category {
  id             String   @id @default(cuid())
  tenantId       String
  parentId       String?
  title          String
  slug           String
  description    String? // Markdown
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  seoTitle       String?
  seoDescription String?
  legacyId       Int? // Concept500 categories.id (ETL upsert key)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent          Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]       @relation("CategoryTree")
  products        Product[]
  complianceRules ComplianceRule[]

  @@unique([tenantId, slug])
  @@unique([tenantId, legacyId])
  @@index([tenantId, parentId, sortOrder])
  @@map("categories")
}

model Tag {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String? // Markdown
  legacyId    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products ProductTag[]

  @@unique([tenantId, slug])
  @@unique([tenantId, name])
  @@unique([tenantId, legacyId])
  @@map("tags")
}

model Product {
  id                       String        @id @default(cuid())
  tenantId                 String
  // Leading human id (decision 26): legacy products.id is preserved here,
  // new ones come from TenantSequence "product.stockCode" (start 50000).
  stockCode                Int
  sku                      String?
  slug                     String
  title                    String
  description              String? // Markdown
  specifications           Json? // [{ label, value }] — ordered list
  status                   ProductStatus @default(DRAFT)
  price                    Int // minor units, tenant currency
  purchasePrice            Int? // minor units; current cost basis (OrderLine snapshots it)
  weightGrams              Int           @default(0)
  // Cached sum of StockMovement.delta — updated in the same transaction as the movement.
  quantity                 Int           @default(0)
  importance               Int           @default(0) // manual sort weight (legacy "importance")
  publishedAt              DateTime? // listing date; "bump to top" = set to now()
  soldAt                   DateTime?
  ageRestricted            Boolean       @default(false)
  blurred                  Boolean       @default(false) // sensitive: blurred + login required for guests
  acceptsOffers            Boolean       @default(false)
  restrictedSymbols        Boolean       @default(false) // e.g. §86a StGB — compliance display rules
  onSale                   Boolean       @default(false) // legacy "sale_item"
  // Sold archive (docs/sold-archive.md): sold items stay visible as reference unless hidden;
  // the sold price is shown only when the dealer ticks it per item.
  archiveHidden            Boolean       @default(false)
  showSoldPrice            Boolean       @default(false)
  // Fair mode (docs/fair-mode.md): set while the item is on a LIVE fair that hides fair stock from
  // the webshop; cleared when the fair ends or the item is taken off the fair.
  fairHoldId               String?
  // Phase 5 — provenance & compliance
  provenance               String? // public Markdown provenance (collection history); legacy: none (new)
  authenticityGuaranteed   Boolean       @default(false) // shows the lifetime authenticity guarantee
  requiresDeactivationCert Boolean       @default(false) // deactivated weapons (EU 2018/337): certificate must be on file before ACTIVE
  notes                    String? // internal, never shown in shop
  seoTitle                 String?
  seoDescription           String?
  categoryId               String?
  purchaseRecordId         String?
  legacyData               Json? // ETL leftovers (photo_count, product_id, stock_control, …)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  // Search: the admin search uses `ILIKE '%word%'` on title / description / sku (pg_trgm GIN indexes,
  // migration 20261008120000_search_trigram_indexes). The shop search (src/server/search, docs/search.md)
  // ranks with full-text search on `searchVector` — a STORED generated column (title + sku weight A,
  // description weight C, text search config `qm_search` = simple + unaccent; migration
  // 20261008160000_smart_search). Never written by the app. The dbgenerated() text is the generation
  // expression exactly as Postgres reports it — keep it identical or `migrate dev` sees drift.
  searchVector Unsupported("tsvector")? @default(dbgenerated("((setweight(to_tsvector('qm_search'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('qm_search'::regconfig, COALESCE(sku, ''::text)), 'A'::\"char\")) || setweight(to_tsvector('qm_search'::regconfig, COALESCE(description, ''::text)), 'C'::\"char\"))"))

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  purchaseRecord     PurchaseRecord?     @relation(fields: [purchaseRecordId], references: [id], onDelete: SetNull)
  fairHold           Fair?               @relation("FairHold", fields: [fairHoldId], references: [id], onDelete: SetNull)
  fairItems          FairItem[]
  images             ProductImage[]
  tags               ProductTag[]
  relatedTo          ProductRelation[]   @relation("ProductRelationFrom")
  relatedFrom        ProductRelation[]   @relation("ProductRelationTo")
  stockMovements     StockMovement[]
  reservations       Reservation[]
  cartItems          CartItem[]
  orderLines         OrderLine[]
  wishlistItems      WishlistItem[]
  productFacetValues ProductFacetValue[]
  embeddings         ProductEmbedding[]
  alertDeliveries    AlertDelivery[]
  productDocuments   ProductDocument[]
  certificates       Certificate[]
  offers             Offer[]

  @@unique([tenantId, stockCode])
  @@unique([tenantId, slug])
  @@unique([tenantId, sku])
  @@index([tenantId, status, publishedAt(sort: Desc)])
  @@index([tenantId, categoryId, status])
  @@index([tenantId, soldAt])
  @@index([purchaseRecordId])
  @@index([fairHoldId])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_description_trgm_idx")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_sku_trgm_idx")
  @@index([searchVector], type: Gin, map: "products_search_vector_idx")
  @@map("products")
}

// ─── Smart search (src/server/search, docs/search.md) ───────────────────────

enum EmbeddingKind {
  TEXT  @map("text") // title + category + facets + tags + description (multilingual-e5-small, 384-d)
  IMAGE @map("image") // main photo (SigLIP 2, 768-d)

  @@map("embedding_kind")
}

// One vector per product and kind (pgvector). Written and read only with raw SQL (Prisma cannot
// model `vector`). `contentHash` = sha256 of the embedded input + model id: the indexing job skips
// unchanged products. HNSW indexes (cosine) are partial expression indexes per kind with a fixed
// dimension — `embedding::vector(384)` / `embedding::vector(768)` — created in the migration, so
// queries must use exactly that cast. Changing a model's dimension needs a new migration.
model ProductEmbedding {
  tenantId    String
  productId   String
  kind        EmbeddingKind
  model       String
  dim         Int
  embedding   Unsupported("vector")
  contentHash String
  updatedAt   DateTime              @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, kind])
  @@index([tenantId, kind])
  @@map("product_embeddings")
}

// Latest "Rebuild search index" run per tenant (admin progress card; job `search.reindex-tenant`).
model SearchIndexRun {
  tenantId      String    @id
  status        String // queued | running | done | failed
  force         Boolean   @default(false)
  total         Int       @default(0)
  done          Int       @default(0)
  textEmbedded  Int       @default(0)
  imageEmbedded Int       @default(0)
  failed        Int       @default(0)
  error         String?
  requestedById String?
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  updatedAt     DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("search_index_runs")
}

// Images live on local storage via the StorageDriver (no Cloudflare).
// storageKey = original, e.g. "{tenantId}/products/{productId}/{imageId}.jpg".
// Variants are generated by sharp by convention next to the original:
//   "{tenantId}/products/{productId}/{imageId}/{variant}.webp"
//   with variant ∈ thumb(320w) | card(800w) | large(2000w) | blur(24w placeholder)
// `variants` is the manifest written after processing ({ name: { key, width, height, bytes } });
// null = not processed yet.
model ProductImage {
  id                 String    @id @default(cuid())
  tenantId           String
  productId          String
  storageKey         String
  originalFilename   String?
  mimeType           String?
  byteSize           Int?
  width              Int?
  height             Int?
  sortOrder          Int       @default(0) // 0 = primary/thumbnail
  alt                String?
  variants           Json?
  processedAt        DateTime?
  legacyCloudflareId String? // Concept500 products.photos entry (ETL download source)
  createdAt          DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storageKey])
  @@index([productId, sortOrder])
  @@index([tenantId])
  @@map("product_images")
}

model ProductTag {
  tenantId  String
  productId String
  tagId     String

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@index([tenantId])
  @@map("product_tags")
}

// Directed "related products" (legacy related_products, feature-toggled).
model ProductRelation {
  tenantId         String
  productId        String
  relatedProductId String
  sortOrder        Int    @default(0)

  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product        Product @relation("ProductRelationFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("ProductRelationTo", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId])
  @@index([relatedProductId])
  @@index([tenantId])
  @@map("product_relations")
}

// ─── Purchasing (decision 12: inkoopadministratie + marge) ──────────────────

// Legacy "product_origins": where items were bought (dealer, auction, private).
model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  contact   String? // free text: person, email, phone
  notes     String?
  legacyId  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseRecords PurchaseRecord[]

  @@unique([tenantId, name])
  @@unique([tenantId, legacyId])
  @@map("suppliers")
}

// One purchase (invoice / lot). N products → 1 record; each Product keeps its own
// purchasePrice (allocated cost). Margin = Σ OrderLine.lineTotal − Σ purchasePriceSnapshot × qty.
model PurchaseRecord {
  id            String   @id @default(cuid())
  tenantId      String
  supplierId    String?
  purchasedAt   DateTime @db.Date
  invoiceNumber String?
  totalCost     Int? // minor units, as invoiced
  currency      String   @default("EUR") @db.Char(3)
  notes         String?
  legacyId      Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  products Product[]

  @@unique([tenantId, legacyId])
  @@index([tenantId, purchasedAt])
  @@index([supplierId])
  @@map("purchase_records")
}

// ─── Stock ledger ───────────────────────────────────────────────────────────

enum StockMovementReason {
  PURCHASE
  SALE
  ADJUSTMENT
  RESERVE
  RELEASE
  RETURN
}

// Append-only ledger. Product.quantity = on-hand stock = Σ delta, kept in sync in
// the same transaction. Cart/checkout holds live in Reservation and do NOT move
// stock (available = quantity − Σ ACTIVE reservations). RESERVE/RELEASE rows are
// audit entries (e.g. admin holds an item for a customer) and may have delta 0;
// all other reasons require delta <> 0 (CHECK constraint in SQL).
model StockMovement {
  id            BigInt              @id @default(autoincrement())
  tenantId      String
  productId     String
  delta         Int
  quantityAfter Int
  reason        StockMovementReason
  orderId       String?
  reservationId String?
  actorId       String?
  note          String?
  createdAt     DateTime            @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  actor       User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([tenantId, createdAt])
  @@index([orderId])
  @@map("stock_movements")
}

// ─── Customers ──────────────────────────────────────────────────────────────

// Guest or account. Identity per tenant = lower-cased email.
model Customer {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String?  @unique
  email           String // lower-case
  firstName       String?
  lastName        String?
  phone           String?
  notes           String? // internal
  // Push alerts (docs/push.md): quiet hours in minutes after local midnight (tenant timezone),
  // daily cap, and which non-search alerts may push.
  pushQuietStart  Int?
  pushQuietEnd    Int?
  pushMaxPerDay   Int      @default(5)
  pushWishlist    Boolean  @default(true) // price drops on wishlist items
  pushReservation Boolean  @default(true) // "your reservation ends in 3 minutes"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  pushSubscriptions     PushSubscription[]
  pushMessages          PushMessage[]
  addresses             Address[]
  orders                Order[]
  carts                 Cart[]
  wishlistItems         WishlistItem[]
  newsletterSubscribers NewsletterSubscriber[]
  savedSearches         SavedSearch[]
  alertDeliveries       AlertDelivery[]
  offers                Offer[]

  @@unique([tenantId, email])
  @@index([tenantId, createdAt])
  @@map("customers")
}

enum AddressType {
  BILLING
  SHIPPING
}

model Address {
  id          String      @id @default(cuid())
  tenantId    String
  customerId  String
  type        AddressType @default(SHIPPING)
  isDefault   Boolean     @default(false)
  firstName   String
  lastName    String
  company     String?
  street      String
  houseNumber String?
  line2       String?
  postalCode  String?
  city        String
  region      String? // state/province
  countryCode String      @db.Char(2) // ISO 3166-1 alpha-2, upper-case
  phone       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([tenantId])
  @@map("addresses")
}

model WishlistItem {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  productId  String
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([productId])
  @@index([tenantId])
  @@map("wishlist_items")
}

// ─── Cart & reservation ─────────────────────────────────────────────────────

model Cart {
  id                  String    @id @default(cuid())
  tenantId            String
  tokenHash           String    @unique // sha256 of the cart cookie token
  customerId          String?
  countryCode         String?   @db.Char(2) // chosen/derived shipping country (zone lookup)
  couponCode          String? // code entered in the cart (validated again at checkout)
  // Abandoned-cart reminder (only with consent: logged-in customer or explicit opt-in at checkout)
  email               String?
  reminderConsent     Boolean   @default(false)
  abandonedMailSentAt DateTime?
  expiresAt           DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        CartItem[]
  reservations Reservation[]

  @@index([tenantId, updatedAt])
  @@index([customerId])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  tenantId  String
  cartId    String
  productId String
  quantity  Int      @default(1)
  offerId   String? // accepted offer → line uses the offer price instead of the list price
  addedAt   DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
  @@index([tenantId])
  @@map("cart_items")
}

enum ReservationStatus {
  ACTIVE // holds the product
  CONVERTED // became a sale (order paid/finalized)
  RELEASED // removed from cart / payment failed / canceled
  EXPIRED // TTL passed (set by sweeper or by the next reserve attempt)
}

// Hold on a product for 15 min (decision 18). Created on add-to-cart, moved to the
// order (orderId) at checkout and extended while the Mollie payment is open.
// At most ONE ACTIVE reservation per product: partial unique index in SQL
// ("reservations_active_product_key" … WHERE status = 'ACTIVE').
// expiresAt cannot be in an index predicate, so a reserve attempt first flips
// expired ACTIVE rows to EXPIRED inside the same transaction.
model Reservation {
  id         String            @id @default(cuid())
  tenantId   String
  productId  String
  cartId     String?
  orderId    String?
  quantity   Int               @default(1)
  status     ReservationStatus @default(ACTIVE)
  expiresAt  DateTime
  releasedAt DateTime? // set when leaving ACTIVE
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  cart           Cart?           @relation(fields: [cartId], references: [id], onDelete: SetNull)
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]

  @@index([productId, status])
  @@index([status, expiresAt])
  @@index([cartId])
  @@index([orderId])
  @@index([tenantId])
  @@map("reservations")
}

// ─── Orders ─────────────────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

// WIP (decision 8): model ready, UI shows a WIP label.
enum FulfillmentStatus {
  UNFULFILLED
  PACKED
  SHIPPED
  DELIVERED
}

enum ShippingMethod {
  SHIP
  PICKUP
}

model Order {
  id                  String            @id @default(cuid())
  tenantId            String
  number              Int // per-tenant sequence "order.number"; legacy orders.id preserved
  uuid                String            @unique @default(uuid()) @db.Uuid // public status-page token
  customerId          String?
  // snapshot of the customer at checkout
  email               String
  customerName        String
  phone               String?
  // amounts (minor units, `currency`)
  currency            String            @db.Char(3)
  subtotal            Int
  shippingTotal       Int               @default(0)
  surchargeTotal      Int               @default(0)
  surchargeLabel      String? // snapshot of the payment-method surcharge label shown to the customer ("PayPal fee")
  surchargeDetail     Json? // snapshot of the surcharge rule at checkout { method, percentBps, fixed, cap, base, amount, rounding }
  discountTotal       Int               @default(0) // coupon discount (phase 5); total = subtotal - discount + shipping + surcharge
  couponCode          String? // snapshot of the applied code
  offerId             String? // set when the order came from an accepted offer
  channel             OrderChannel      @default(WEB)
  fairId              String? // set for sales made in fair mode
  clientRef           String? // idempotency key from the fair-mode client (offline sales sync exactly once)
  total               Int // subtotal + shipping + surcharge
  paymentStatus       PaymentStatus     @default(PENDING)
  fulfillmentStatus   FulfillmentStatus @default(UNFULFILLED)
  paymentMethod       String? // snapshot of chosen method ("ideal", "creditcard", legacy "BANK_TRANSFER", …)
  // shipping snapshot
  shippingMethod      ShippingMethod    @default(SHIP)
  shippingZoneId      String?
  shippingZoneName    String?
  shippingWeightGrams Int?
  // fulfillment (WIP)
  carrier             String?
  trackingNumber      String?
  trackingUrl         String?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  // lifecycle
  placedAt            DateTime          @default(now())
  paidAt              DateTime?
  canceledAt          DateTime?
  // Idempotent completion marker: the webhook/finalizer sets this in the same
  // transaction as stock SALE movements; `WHERE finalizedAt IS NULL` guards re-runs.
  finalizedAt         DateTime?
  confirmationSentAt  DateTime? // order mail sent (idempotency for mail job)
  archivedAt          DateTime? // orders are never deleted (decision 10)
  customerNote        String? // message from the customer at checkout
  notes               String? // internal
  legacyData          Json? // ETL: raw payment_status/method, legacyNoLines, region, …
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shippingZone   ShippingZone?   @relation(fields: [shippingZoneId], references: [id], onDelete: SetNull)
  fair           Fair?           @relation(fields: [fairId], references: [id], onDelete: SetNull)
  fairItems      FairItem[]
  lines          OrderLine[]
  addresses      OrderAddress[]
  payments       Payment[]
  events         OrderEvent[]
  reservations   Reservation[]
  stockMovements StockMovement[]
  invoice        Invoice?

  @@unique([tenantId, number])
  @@unique([tenantId, clientRef])
  @@index([fairId])
  @@index([tenantId, placedAt(sort: Desc)])
  @@index([tenantId, paymentStatus, placedAt(sort: Desc)])
  @@index([tenantId, fulfillmentStatus])
  @@index([tenantId, archivedAt])
  @@index([tenantId, email])
  @@index([customerId])
  @@map("orders")
}

model OrderLine {
  id                    String   @id @default(cuid())
  tenantId              String
  orderId               String
  productId             String? // null when the product was deleted; snapshot stays
  // snapshot
  title                 String
  stockCode             Int?
  sku                   String?
  imagePath             String? // storage key of the primary image variant at order time
  unitPrice             Int
  quantity              Int      @default(1)
  lineTotal             Int // unitPrice × quantity
  purchasePriceSnapshot Int? // cost basis at sale time → margin report
  priceReconstructed    Boolean  @default(false) // ETL: legacy order_details.price was rounded euros
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([tenantId])
  @@map("order_lines")
}

model OrderAddress {
  id          String      @id @default(cuid())
  tenantId    String
  orderId     String
  type        AddressType
  firstName   String
  lastName    String
  company     String?
  street      String
  houseNumber String?
  line2       String?
  postalCode  String?
  city        String
  region      String?
  countryCode String      @db.Char(2)
  phone       String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@index([tenantId])
  @@map("order_addresses")
}

// Timeline / status history. type examples: "created", "payment.paid",
// "payment.failed", "fulfillment.shipped", "note", "email.sent", "archived".
model OrderEvent {
  id        BigInt   @id @default(autoincrement())
  tenantId  String
  orderId   String
  type      String
  data      Json? // e.g. { from, to } or { note }
  actorId   String? // null = system/webhook/customer
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([tenantId, createdAt])
  @@map("order_events")
}

enum OrderChannel {
  WEB // webshop checkout
  FAIR // fair mode (docs/fair-mode.md)
  MANUAL // created in the admin / legacy manual orders
}

enum PaymentProvider {
  MOLLIE // only live provider (decision 16)
  MANUAL // admin "mark as paid" / legacy bank transfer & cash (ETL)
}

enum PaymentAttemptStatus {
  OPEN
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELED
  EXPIRED
}

// One row per payment attempt; an order may have several (retries).
model Payment {
  id                String               @id @default(cuid())
  tenantId          String
  orderId           String
  provider          PaymentProvider      @default(MOLLIE)
  providerPaymentId String?              @unique // Mollie "tr_…"; null for MANUAL
  method            String? // ideal, bancontact, creditcard, paypal, …
  status            PaymentAttemptStatus @default(OPEN)
  amount            Int
  amountRefunded    Int                  @default(0)
  currency          String               @db.Char(3)
  checkoutUrl       String?
  raw               Json? // last provider payload (debugging)
  paidAt            DateTime?
  failedAt          DateTime?
  canceledAt        DateTime?
  expiredAt         DateTime?
  expiresAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([tenantId, createdAt])
  @@map("payments")
}

// WIP (decision 9): stub so invoice numbering has a home; PDF/margin-scheme later.
model Invoice {
  id         String   @id @default(cuid())
  tenantId   String
  orderId    String   @unique
  number     Int // per-tenant sequence "invoice.number"
  issuedAt   DateTime @default(now())
  total      Int
  currency   String   @db.Char(3)
  vatScheme  String? // e.g. "MARGIN" (margeregeling) — WIP
  storageKey String? // generated PDF
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([tenantId, number])
  @@map("invoices")
}

// ─── Shipping (decision 21: zones per ISO country + weight tiers) ───────────

model ShippingZone {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  countries String[] // ISO 3166-1 alpha-2, upper-case; ["*"] = rest of world
  sortOrder Int      @default(0) // first matching zone wins
  isPickup  Boolean  @default(false) // "pickup in store": no address/weight needed
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rates  ShippingRate[]
  orders Order[]

  @@index([tenantId, sortOrder])
  @@map("shipping_zones")
}

// Rate = first tier with maxWeightGrams ≥ cart weight.
model ShippingRate {
  id              String   @id @default(cuid())
  tenantId        String
  zoneId          String
  maxWeightGrams  Int
  price           Int // minor units, tenant currency
  // optional insurance
  insurancePrice  Int? // extra charge when insured
  maxInsuredValue Int? // insured up to this order value
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  zone   ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, maxWeightGrams])
  @@index([tenantId])
  @@map("shipping_rates")
}

// ─── Content (one block CMS) ────────────────────────────────────────────────

enum ContentBlockType {
  HERO
  TEXT
  TEXT_HORIZONTAL
  TEXT_IMAGE
  TEXT_PRODUCT
  TEXT_CAROUSEL
  QUOTE
  CTA
  TESTIMONIAL
  NEW_ITEMS
  GALLERY
  CATEGORIES
  NEWSLETTER_SIGNUP // legacy EMAILER
  FAQ // question/answer pairs (FAQPage JSON-LD); new in Quartermaster
}

model ContentPage {
  id             String    @id @default(cuid())
  tenantId       String
  slug           String // "" = home is avoided; home uses systemKey HOME + slug "home"
  title          String
  systemKey      String? // HOME, TERMS, PRIVACY, ABOUT, CONTACT, … (legacy ShopPageEnum)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime? // null = draft
  legacyId       Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  blocks    ContentBlock[]
  menuItems MenuItem[]

  @@unique([tenantId, slug])
  @@unique([tenantId, systemKey])
  @@unique([tenantId, legacyId])
  @@map("content_pages")
}

// `data` is validated by a Zod discriminated union on `type` (relative URLs only).
model ContentBlock {
  id        String           @id @default(cuid())
  tenantId  String
  pageId    String
  type      ContentBlockType
  data      Json
  sortOrder Int              @default(0)
  isVisible Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  page   ContentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sortOrder])
  @@index([tenantId])
  @@map("content_blocks")
}

enum MenuLocation {
  HEADER
  FOOTER
}

model MenuItem {
  id        String       @id @default(cuid())
  tenantId  String
  location  MenuLocation
  parentId  String?
  label     String
  url       String? // relative ("/shop") or absolute external; else pageId
  pageId    String?
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent   MenuItem?    @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[]   @relation("MenuTree")
  page     ContentPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([tenantId, location, parentId, sortOrder])
  @@map("menu_items")
}

// ─── Newsletter (decision 14: own sending) ──────────────────────────────────

// Status is derived: confirmedAt null → pending; unsubscribedAt set → unsubscribed.
// Unsubscribe links use an HMAC(subscriberId) signature, so no stored token is needed.
model NewsletterSubscriber {
  id               String    @id @default(cuid())
  tenantId         String
  email            String // lower-case
  customerId       String?
  confirmTokenHash String?   @unique // sha256 of the double-opt-in token
  confirmSentAt    DateTime?
  confirmedAt      DateTime? // = consent timestamp (AVG)
  unsubscribedAt   DateTime?
  source           String? // "footer", "checkout", "popup", "import"
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([tenantId, email])
  @@index([tenantId, confirmedAt, unsubscribedAt])
  @@map("newsletter_subscribers")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

model NewsletterCampaign {
  id             String         @id @default(cuid())
  tenantId       String
  subject        String
  body           String // Markdown; rendered via React Email template
  status         CampaignStatus @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int            @default(0)
  sentCount      Int            @default(0)
  failedCount    Int            @default(0)
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
  @@map("newsletter_campaigns")
}

// ─── Analytics (own, cookieless) ────────────────────────────────────────────

// visitorHash = sha256(dailySalt + tenantId + ip + userAgent); the salt rotates
// daily and is discarded, so visitors cannot be tracked across days. No raw IP/UA stored.
model PageView {
  id           BigInt   @id @default(autoincrement())
  tenantId     String
  path         String // without query string
  referrerHost String?
  countryCode  String?  @db.Char(2)
  visitorHash  String
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, path, createdAt])
  @@index([tenantId, visitorHash, createdAt])
  @@map("page_views")
}

// ═══ Phase 5 ═════════════════════════════════════════════════════════════════
// ETL notes (Concept500 → Quartermaster) are kept next to each model.

// ─── Facet taxonomy ─────────────────────────────────────────────────────────
// Structured classification: period · country · branch · unit · type · maker (+ custom).
// ETL: legacy tags/categories are mapped to facet values via FacetValue.legacyTagId / a mapping file;
// unmapped legacy tags stay plain Tags.

enum FacetKind {
  PERIOD
  COUNTRY
  BRANCH
  UNIT
  TYPE
  MAKER
  CUSTOM
}

model Facet {
  id           String    @id @default(cuid())
  tenantId     String
  kind         FacetKind
  name         String
  slug         String
  sortOrder    Int       @default(0)
  isFilterable Boolean   @default(true) // shown as a filter in the shop
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  values FacetValue[]

  @@unique([tenantId, slug])
  @@index([tenantId, sortOrder])
  @@map("facets")
}

model FacetValue {
  id          String   @id @default(cuid())
  tenantId    String
  facetId     String
  parentId    String? // hierarchy, e.g. Germany › Heer › Infanterie
  name        String
  slug        String
  sortOrder   Int      @default(0)
  legacyTagId Int? // ETL: Concept500 tags.id this value replaces
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  facet    Facet               @relation(fields: [facetId], references: [id], onDelete: Cascade)
  parent   FacetValue?         @relation("FacetValueTree", fields: [parentId], references: [id], onDelete: SetNull)
  children FacetValue[]        @relation("FacetValueTree")
  products ProductFacetValue[]

  @@unique([facetId, slug])
  @@index([tenantId, facetId, sortOrder])
  @@index([parentId])
  @@map("facet_values")
}

model ProductFacetValue {
  tenantId     String
  productId    String
  facetValueId String

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  facetValue FacetValue @relation(fields: [facetValueId], references: [id], onDelete: Cascade)

  @@id([productId, facetValueId])
  @@index([tenantId, facetValueId])
  @@map("product_facet_values")
}

// ─── Saved searches & alerts ("notify me") ──────────────────────────────────
// Guests confirm by email (double opt-in, like the newsletter); customers are confirmed at once.

enum AlertFrequency {
  INSTANT
  DAILY
  WEEKLY
}

model SavedSearch {
  id               String         @id @default(cuid())
  tenantId         String
  customerId       String?
  email            String // lower-case
  name             String
  query            Json // normalised catalog params: { q, categoryId, facetValueIds[], tagIds[], priceMin, priceMax }
  frequency        AlertFrequency @default(DAILY)
  push             Boolean        @default(false) // also/instead deliver INSTANT matches as web push (needs a customer with a subscription)
  confirmedAt      DateTime?
  confirmTokenHash String?        @unique
  unsubscribedAt   DateTime?
  lastNotifiedAt   DateTime?
  lastMatchedAt    DateTime? // publishedAt watermark: only products published after this are new
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deliveries AlertDelivery[]

  @@index([tenantId, confirmedAt])
  @@index([customerId])
  @@index([tenantId, email])
  @@map("saved_searches")
}

enum AlertKind {
  SAVED_SEARCH // new product matches a saved search
  BACK_AVAILABLE // wishlist item released from a cart / reservation
  PRICE_DROP // wishlist item price lowered
  RESERVATION_ENDING // push only: the visitor's cart reservation is about to lapse
}

/// One row per (alert, product) so nobody gets the same product twice.
model AlertDelivery {
  id            String    @id @default(cuid())
  tenantId      String
  kind          AlertKind
  savedSearchId String?
  customerId    String?
  productId     String
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  savedSearch SavedSearch? @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([savedSearchId, productId])
  @@unique([kind, customerId, productId])
  @@index([tenantId, sentAt])
  @@map("alert_deliveries")
}

// ─── Provenance documents & certificates of authenticity ────────────────────
// ETL: Concept500 product_origins / purchase_records stay internal (PurchaseRecord); public
// provenance text is new. Legacy has no documents/certificates.

enum ProductDocumentKind {
  PROVENANCE // letters, photos, collection labels
  DEACTIVATION_CERT // EU deactivation certificate (required when requiresDeactivationCert)
  INVOICE_HISTORIC
  OTHER
}

model ProductDocument {
  id         String              @id @default(cuid())
  tenantId   String
  productId  String
  kind       ProductDocumentKind
  title      String
  storageKey String // local storage: {tenantId}/products/{productId}/docs/{id}.{ext}
  mimeType   String
  byteSize   Int
  isPublic   Boolean             @default(false) // visible on the product page
  createdAt  DateTime            @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId])
  @@map("product_documents")
}

model Certificate {
  id         String    @id @default(cuid())
  tenantId   String
  productId  String
  code       String    @unique // short public verification code, e.g. QM-7K4P-2XQ9 (printed + QR)
  issuedAt   DateTime  @default(now())
  issuedById String?
  revokedAt  DateTime?
  reason     String? // revocation reason
  snapshot   Json // product facts at issue time (title, stockCode, specs, provenance, image key)
  storageKey String? // generated PDF

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, productId])
  @@map("certificates")
}

// ─── Compliance per country ─────────────────────────────────────────────────
// Rules are matched by category (incl. descendants) or by a product flag, for the visitor's /
// shipping country. ETL: legacy "blur" stays Product.blurred; no legacy rules.

enum ComplianceMatch {
  CATEGORY
  RESTRICTED_SYMBOLS
  AGE_RESTRICTED
  DEACTIVATED_WEAPON
}

enum ComplianceAction {
  BLUR_IMAGES // show blurred images to visitors from these countries
  HIDE_PRODUCT // hide from listings and product pages
  NO_SHIPPING // cannot be shipped to these countries (checkout blocks)
}

model ComplianceRule {
  id         String           @id @default(cuid())
  tenantId   String
  name       String
  match      ComplianceMatch
  categoryId String? // when match = CATEGORY
  countries  String[] // ISO-2
  action     ComplianceAction
  isActive   Boolean          @default(true)
  note       String? // e.g. "§86a StGB"
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@map("compliance_rules")
}

// ─── Offers ("make an offer") ───────────────────────────────────────────────

enum OfferStatus {
  PENDING
  ACCEPTED
  COUNTERED
  REJECTED
  EXPIRED
  WITHDRAWN
  CONVERTED // paid through the personal checkout link
}

model Offer {
  id                String      @id @default(cuid())
  tenantId          String
  productId         String
  customerId        String?
  email             String
  name              String
  amount            Int // offered price, minor units
  currency          String      @db.Char(3)
  message           String?
  status            OfferStatus @default(PENDING)
  counterAmount     Int?
  agreedAmount      Int? // final price when ACCEPTED / counter accepted
  responseNote      String?
  respondedAt       DateTime?
  respondedById     String?
  checkoutTokenHash String?     @unique // personal link to buy at the agreed price
  checkoutExpiresAt DateTime?
  orderId           String?     @unique
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([productId])
  @@map("offers")
}

// ─── Coupons ────────────────────────────────────────────────────────────────

enum CouponType {
  PERCENT // value = basis points of the subtotal (1000 = 10%)
  FIXED // value = minor units off the subtotal
  FREE_SHIPPING
}

model Coupon {
  id             String     @id @default(cuid())
  tenantId       String
  code           String // stored upper-case
  description    String?
  type           CouponType
  value          Int        @default(0)
  minSubtotal    Int        @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  maxRedemptions Int? // total across all customers
  perEmailLimit  Int?       @default(1)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  redemptions CouponRedemption[]

  @@unique([tenantId, code])
  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(cuid())
  tenantId  String
  couponId  String
  orderId   String   @unique
  email     String
  amount    Int // discount granted, minor units (shipping value for FREE_SHIPPING)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)

  @@index([couponId])
  @@index([tenantId, email])
  @@map("coupon_redemptions")
}

// ─── Exchange rates (display only — checkout is always in the shop currency) ─
// Platform-wide, refreshed daily from the ECB reference rates. ETL: legacy currencies table is
// replaced by this history.

model ExchangeRate {
  id        String   @id @default(cuid())
  base      String   @db.Char(3) // "EUR"
  quote     String   @db.Char(3)
  rate      Decimal  @db.Decimal(18, 8)
  rateDate  DateTime @db.Date
  source    String   @default("ECB")
  createdAt DateTime @default(now())

  @@unique([base, quote, rateDate])
  @@index([base, quote, rateDate(sort: Desc)])
  @@map("exchange_rates")
}

// ─── Leads: "Sell your collection" ──────────────────────────────────────────
// ETL: Concept500 contact/feedback form submissions were not stored — none to migrate.

enum LeadStatus {
  NEW
  CONTACTED
  BOUGHT
  DECLINED
}

model Lead {
  id               String     @id @default(cuid())
  tenantId         String
  name             String
  email            String
  phone            String?
  itemsDescription String
  message          String?
  photos           Json       @default("[]") // [{ key, width, height, bytes }] storage keys under {tenantId}/leads/{id}/
  status           LeadStatus @default(NEW)
  note             String? // internal
  handledById      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("leads")
}

// ─── Redirects (phase 4) ────────────────────────────────────────────────────

enum RedirectSource {
  LEGACY // created by the Concept500 ETL (old URL → new URL)
  MANUAL // added by the shop owner
}

// Exact-path 301/302 redirects per shop, resolved for requests that would otherwise 404.
// `fromPath` is normalised: leading "/", no trailing "/", lower-case, query string only when it is
// part of the match (legacy "/shop.php?code=123").
model Redirect {
  id         String         @id @default(cuid())
  tenantId   String
  fromPath   String
  toPath     String
  statusCode Int            @default(301)
  source     RedirectSource @default(MANUAL)
  hits       Int            @default(0)
  lastHitAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fromPath])
  @@map("redirects")
}

// ─── Dealer onboarding (innovation round 1) ─────────────────────────────────

enum DealerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// A dealer's request for a shop, submitted on the platform host and reviewed by a SUPERADMIN.
// Approval creates the Tenant (tenantId set) and invites the applicant as OWNER.
model DealerApplication {
  id              String                  @id @default(cuid())
  status          DealerApplicationStatus @default(PENDING)
  applicantName   String
  email           String // lower-case
  shopName        String
  country         String                  @db.Char(2)
  cocNumber       String? // Chamber of Commerce / company registration number
  currentPlatform String? // "woocommerce" | "shopify" | "concept500" | "none" | free text
  description     String // what they sell
  legalConsent    Boolean                 @default(false)
  emailVerifiedAt DateTime?
  checks          Json? // automated checks { emailDeliverable, cocFormat, duplicateEmail, … }
  internalNote    String?
  reviewedById    String?
  reviewedAt      DateTime?
  rejectReason    String?
  tenantId        String?                 @unique
  ip              String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
  @@map("dealer_applications")
}

enum ImportSource {
  WOOCOMMERCE
  SHOPIFY
}

enum ImportJobStatus {
  UPLOADED // file parsed, preview available
  RUNNING // rows being created
  IMAGES // products created, images downloading in the background
  DONE
  FAILED
  CANCELED
}

// Product import from another shop system's CSV export (setup wizard + Inventory → Import).
model ImportJob {
  id          String          @id @default(cuid())
  tenantId    String
  source      ImportSource
  status      ImportJobStatus @default(UPLOADED)
  fileName    String
  fileKey     String // storage key of the uploaded CSV (private)
  options     Json // { publish: bool, tagsAs: "facets" | "tags", stockMode: "split" | "single", mapping: {...} }
  summary     Json? // preview/result counts { rows, products, images, categories, warnings[], errors[] }
  createdById String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("import_jobs")
}

// ─── Fair mode (docs/fair-mode.md) ──────────────────────────────────────────

enum FairStatus {
  PREPARING
  LIVE
  ENDED
}

model Fair {
  id           String     @id @default(cuid())
  tenantId     String
  name         String
  startsOn     DateTime   @db.Date
  endsOn       DateTime?  @db.Date
  status       FairStatus @default(PREPARING)
  hideFromShop Boolean    @default(true) // fair items are hidden in the webshop while LIVE
  startedAt    DateTime?
  endedAt      DateTime?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items        FairItem[]
  orders       Order[]
  heldProducts Product[]  @relation("FairHold")

  @@index([tenantId, status])
  @@index([tenantId, startsOn(sort: Desc)])
  @@map("fairs")
}

model FairItem {
  id         String    @id @default(cuid())
  tenantId   String
  fairId     String
  productId  String
  floorPrice Int? // minor units; lowest price the seller may enter at the stand
  soldPrice  Int? // minor units, set when sold at the fair
  soldAt     DateTime?
  orderId    String?
  createdAt  DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fair    Fair    @relation(fields: [fairId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([fairId, productId])
  @@index([productId])
  @@index([tenantId])
  @@map("fair_items")
}

// ─── Web push (docs/push.md) ────────────────────────────────────────────────

model PushSubscription {
  id         String    @id @default(cuid())
  tenantId   String
  customerId String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  lastUsedAt DateTime?
  failedAt   DateTime? // set on 404/410 from the push service; the row is then removed
  createdAt  DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([tenantId])
  @@map("push_subscriptions")
}

/// One row per push sent (daily cap, quiet hours queue, debugging).
model PushMessage {
  id         String    @id @default(cuid())
  tenantId   String
  customerId String
  kind       AlertKind
  title      String
  body       String
  url        String
  dedupeKey  String? // e.g. "reservation:<id>" so one event pushes once
  queuedFor  DateTime? // held back by quiet hours until this time
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, dedupeKey])
  @@index([tenantId, sentAt])
  @@index([customerId, createdAt])
  @@map("push_messages")
}
