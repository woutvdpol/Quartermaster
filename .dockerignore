# Dependencies & build output (rebuilt inside the image)
node_modules
.next
out
dist
coverage
.turbo
src/generated
*.tsbuildinfo
next-env.d.ts

# VCS, CI, editor
.git
.gitignore
.github
.idea
.vscode
.DS_Store
*.log

# Secrets & private data — never bake into an image
.env
.env.*
!.env.example
.local
*.sql
*.sql.gz

# Runtime data
uploads
public/uploads

# Docs, tests & tooling not needed in the image
docs
tests
README.md
AGENTS.md
CLAUDE.md
.claude
Dockerfile
.dockerignore
docker-compose.yml
# Test files colocated in src/ (they import tests/ helpers, which are excluded above)
src/**/*.test.ts
src/**/*.test.tsx
vitest.config.ts
vitest.integration.config.ts
